+            // Waiter counters describe queued tasks, not active lock holders.
+            // Preserve them while atomically claiming an otherwise unheld lock.
+            if (current & ACTIVE_LOCKS_MASK) != 0 {
+                return false;
+            }
+
+            let new_state = current | WRITER_FLAG_MASK;
+            if self
+                .state
+                .compare_exchange_weak(current, new_state, Ordering::AcqRel, Ordering::Relaxed)
+                .is_ok()
+            {
+                return true;
+            }
+        }
